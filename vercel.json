{
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/chat",
      "dest": "/api/app"
    },
    {
      "src": "/(.*)",
      "dest": "/api/app"
    }
  ]
}